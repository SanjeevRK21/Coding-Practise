Q) Longest palindrome substring
Methode 1:
okay here you basically use left and right as variable names and check for each element if they come in the middle of a palindrome substring
this is done for odd palindrome substring where r = l = i; now for even palindrome you set l = i and i = i+1 and check 
the base condition is gonna be while(l>=0 && r <n && s[l]==s[r]) this is gonna be under for loop of (i from 0 to n-1)
core code is gonna be:

class Solution {
public:
    string longestPalindrome(string s) {
        int n = s.size();
        string res = "";
        int resLen = 0;

        for (int i = 0; i < n; i++) {

            // -------- odd length palindrome --------
            int l = i, r = i;
            while (l >= 0 && r < n && s[l] == s[r]) {
                if (r - l + 1 > resLen) {
                    res = s.substr(l, r - l + 1);
                    resLen = r - l + 1;
                }
                l--;
                r++;
            }

            // -------- even length palindrome --------
            l = i;
            r = i + 1;
            while (l >= 0 && r < n && s[l] == s[r]) {
                if (r - l + 1 > resLen) {
                    res = s.substr(l, r - l + 1);
                    resLen = r - l + 1;
                }
                l--;
                r++;
            }
        }
        return res;
    }
};



