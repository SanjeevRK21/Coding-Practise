Palindrome substring: here we need to find how many palindrome substring we can find in string s. its the same methode as the longest palindrome substring but the only differrence 
here is that in the while condition we need not check if its greater than maxlen not store any palindrome,
but instead take a temp int variable palins and keep adding it as the while loop executes;

class Solution {
public:
    int countSubstrings(string s) {
        int n = s.size();
        int r,l;
        int palins = 0;
        for(int i =0; i<n;i++){
                r = i;
                l = i;
                while(l>=0 && r<n && s[r]==s[l]){
                    palins++;
                    l--;
                    r++;
                }
                r = i+1;
                l = i;
                while(l>=0 && r<n && s[r]==s[l]){
                    palins ++;
                    l--;
                    r++;
                }
        }
          return palins;
    }
};

